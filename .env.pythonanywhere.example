APP_CONFIG=production
SECRET_KEY=replace-with-a-long-random-secret
DATA_ROOT=/home/USERNAME/pythonstudy-data
DATABASE_URL=sqlite:////home/USERNAME/pythonstudy-data/pythonstudy.db
UPLOAD_ROOT=/home/USERNAME/pythonstudy-data/uploads
GENERATED_ROOT=/home/USERNAME/pythonstudy-data/generated
TEMP_ROOT=/home/USERNAME/pythonstudy-data/temp
CODE_EXECUTION_ENABLED=true
CODE_TIMEOUT_SECONDS=2
CODE_MEMORY_MB=128
CODE_OUTPUT_LIMIT=20000
MAX_CONTENT_LENGTH=10485760
